# Copier ce fichier en .env (jamais commité) et remplir les valeurs.

# Token de l'intégration Notion interne, en lecture seule
NOTION_TOKEN=

# Facultatif : identifiant de la data source Notion à lire (sinon celle du dépôt d'origine)
# NOTION_DATA_SOURCE_ID=

# Adresse transmise à OpenAlex dans le paramètre mailto
OPENALEX_MAILTO=

# Facultatif : dossier « storage » de Zotero s'il n'est pas à l'emplacement par défaut
# ZOTERO_STORAGE=C:\Users\moi\OneDrive\Zotero\storage
